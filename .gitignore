# dependencies / build
node_modules/
# git worktrees link node_modules (and .env) to the main checkout rather than
# reinstalling. A trailing slash matches a directory but NOT a symlink, so the
# link showed as untracked and a `git add -A` would have committed an absolute
# path pointing at one machine. Both forms are needed.
node_modules
.env
.next/
out/
*.tsbuildinfo
next-env.d.ts

# local data — statements, database, backups NEVER enter git
data/
# the drop folder statements land in before import. Same rule as data/. These
# are real PDFs: the Chase ones mask the card number themselves but still carry
# the cardholder name and every itemized purchase, and the Robinhood ones carry
# a full account number and home address. Untracked-but-not-ignored until
# 2026-08-05, so one `git add -A` would have published 143 of them.
statements/

# env
.env*
!.env.example

# test artifacts
coverage/
playwright-report/
test-results/

# os
.DS_Store
.trial/

# ⛔ Agent scratch probes. A reading agent writes `probe-*.ts` / `.p.ts` into the
# repo root because tsx can only resolve `@/` from inside it, and four commits on
# 2026-09-11 swept twelve of them in behind a `git add -A`. One of them broke
# `tsc --noEmit`. Ignored so it cannot happen again.
#
# ⛔ ANCHORED AT THE ROOT. An unanchored `*probe*.ts` also matched the repo's own
# committed `scripts/probe-*.ts` — 50 of them — so the next legitimate probe
# would have been silently ignored.
/probe-*.ts
/*probe*.ts
/*probe*.mjs
/.p*.ts
/zz*.ts
/zz*.mts
/.skeptic-probe-*.ts
