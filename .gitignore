# dependencies / build
node_modules/
# git worktrees link node_modules (and .env) to the main checkout rather than
# reinstalling. A trailing slash matches a directory but NOT a symlink, so the
# link showed as untracked and a `git add -A` would have committed an absolute
# path pointing at one machine. Both forms are needed.
node_modules
.env
.next/
out/
*.tsbuildinfo
next-env.d.ts

# local data — statements, database, backups NEVER enter git
data/

# env
.env*
!.env.example

# test artifacts
coverage/
playwright-report/
test-results/

# os
.DS_Store
.trial/
