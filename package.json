{
  "name": "moneyapp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:fast": "vitest run",
    "e2e": "playwright test",
    "e2e:update": "playwright test --update-snapshots",
    "e2e:fresh": "next build && playwright test",
    "db:generate": "drizzle-kit generate",
    "fixtures": "tsx scripts/fixtures/generate.ts",
    "backup:statements": "tsx scripts/backup-statements.ts",
    "trial-import": "tsx scripts/trial-import.ts",
    "rh-sweep-check": "tsx scripts/rh-sweep-check.ts",
    "assert-fixture-shape": "tsx scripts/assert-fixture-shape.ts",
    "propose-budgets": "tsx scripts/propose-budgets.ts",
    "import-statements": "tsx scripts/import-statements.ts",
    "demo:load": "MONEYAPP_FAKE_PRICES=1 tsx scripts/demo/load-demo.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed-run.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "sharp",
      "@tailwindcss/oxide"
    ]
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "better-sqlite3": "^12.11.1",
    "drizzle-orm": "0.45.2",
    "geist": "^1.7.2",
    "lucide-react": "^1.24.0",
    "next": "^16.2.10",
    "next-themes": "^0.4.6",
    "papaparse": "^5.5.4",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "recharts": "^3.9.2",
    "unpdf": "^1.6.2",
    "yahoo-finance2": "^3.15.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.1",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.10",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
