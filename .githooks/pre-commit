#!/bin/sh
#
# PASS 74 — `pnpm ledger-check` on every commit, instead of when somebody
# thinks to run it.
#
# ⛔ What it is guarding. `statement_periods.reconciliation` and `gap_cents`
# were written once at import and nothing revisited them, so a hand-entered
# +$3,579.67 plug held July 2026 at a stored gap of $231.85 while the real
# figure was $3,811.52. Pass 74 stops that drift being POSSIBLE (rebuildAccount
# re-grades); this stops the other findings — a chain break, money in the
# balance chain with no source document, a statement whose printed market value
# the ledger disagrees with — sitting undiscovered between sessions.
#
# It takes about three quarters of a second and needs no network.
#
# ⚠️ SILENT when there is no database. A fresh clone, a CI runner and a
# worktree all have no `data/moneyapp.db` (it is gitignored), and a hook that
# failed there would be a hook everybody turns off.
#
# To commit past a failure — which should be a deliberate act, not a habit:
#
#     git commit --no-verify
#
# Wired by `pnpm run prepare` (git config core.hooksPath .githooks), so it
# arrives with an install rather than having to be copied into .git/hooks by
# hand, where it would be untracked and invisible.
# ⚠️ It WRITES, rarely. The first run on a ledger records a high-water mark per
# kind of witness it counts (ledger_witness_marks, inside the ledger), and a run
# that counts more raises it — so a new statement needs no commit. A run that
# counts FEWER, or misses any witness the mark lists however many it counts,
# fails and names what left — and writes only to add what arrived meanwhile to
# that mark; lowering a mark after a removal the owner approved is
# `pnpm ledger-check --lower-marks=<kind> --confirm`.
set -e

DB="${MONEYAPP_DB_PATH:-data/moneyapp.db}"
if [ ! -s "$DB" ]; then
  exit 0
fi

if ! command -v pnpm >/dev/null 2>&1; then
  echo "pre-commit: pnpm not on PATH — skipping the ledger check" >&2
  exit 0
fi

# Quiet on success. A hook that prints fifteen lines of healthy ledger on every
# commit is a hook that stops being read, and then stops being kept.
OUT=$(pnpm --silent ledger-check 2>&1) || {
  echo "$OUT" >&2
  echo "" >&2
  echo "The ledger does not match its recorded baseline, or a witness it counted is gone (scripts/ledger-check.ts)." >&2
  echo "Understand what the money is before committing; 'git commit --no-verify' if you must." >&2
  exit 1
}

# …all but what the check NAMES and fails nothing on — a read at two banks, a line
# left out that a session acknowledged, … — printed in one shape, under its count
# line (`listed`, src/lib/ledger-check-listing.ts): those lines, each under its
# count line, and nothing else of a passing run. 🔴 This hook threw a passing run's
# output away whole, so a listing showed only on a manual run (the handoff of
# 2026-10-07, §6C). scripts/pre-commit-hook.test.ts runs this hook.
LISTED=$(printf '%s\n' "$OUT" | awk '
  # a count line, at the margin: what any listing below it is counted by
  $0 != "" && substr($0, 1, 1) != " " { count = $0; shown = 0; more = 0; next }
  # a listing: two spaces, ⚠️ where it warns, its tag in brackets
  index($0, "  [") == 1 || index($0, "  ⚠️ [") == 1 {
    if (!shown && count != "") print count
    shown = 1; more = 1; print; next
  }
  # the indented lines a listing carries on to (a command to run)
  more && index($0, "    ") == 1 { print; next }
  { more = 0 }
')
if [ -n "$LISTED" ]; then
  echo "pnpm ledger-check passed, and names what it does not fail on:" >&2
  printf '%s\n' "$LISTED" >&2
fi
